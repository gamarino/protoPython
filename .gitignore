# Keep runtime diagnostic output out of the repository
*.log
exec_diag_*
verify*.txt
out*.txt
test*.txt
debug*.txt
*trace*.txt
*diff*.txt

# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# Build artifacts — all out-of-tree build directory variants
build/
build*/
cmake-build-*/
.idea/
.gitnexus
Testing/
benchmarks/compiled/

# Developer scratch / profiling output
scratch/
tmp_test/
*.out
*.gdb
log_*.txt
repro_output.txt

# Packaging output
*.deb
*.rpm
*.tar.gz

# Local build trees, profiling data and debugging leftovers
/wsl-build/
/gmon.out
/run_debug.gdb
/build_damage.diff
/test/compiler/run_module

# Captured debug output, gdb command files and compiled binaries in tests/
# (anchored to the top level of tests/; test sources and tests/conformity/ stay tracked)
/tests/*.txt
/tests/*.out
/tests/*.o
/tests/*.so
/tests/*.log*
/tests/perf.data*
/tests/gdb_cmds
/tests/gdb_script
/tests/diagnostic_output_txt
/tests/run
/tests/test_hasattr
/tests/test_interning

# Internal working notes (task lists, plans); not part of the repository
/tasks/
