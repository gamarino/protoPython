{
  "name": "protopy-debug",
  "displayName": "protoPython Debugger",
  "description": "Debug Python scripts on protoPython (protopy) from VS Code, through the protopy --dap Debug Adapter Protocol adapter.",
  "version": "0.3.1",
  "publisher": "protopython-placeholder",
  "engines": {
    "vscode": "^1.66.0"
  },
  "categories": [
    "Debuggers"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onDebugResolve:protopy",
    "onDebugInitialConfigurations",
    "onDebugDynamicConfigurations:protopy"
  ],
  "contributes": {
    "configuration": {
      "title": "protoPython",
      "properties": {
        "protopy.path": {
          "type": "string",
          "default": "",
          "description": "Path to the protopy executable. Empty: the default install location (%LOCALAPPDATA%\\Programs\\proto\\bin\\protopy.exe on Windows, ~/.local/bin/protopy elsewhere), else protopy from PATH."
        }
      }
    },
    "breakpoints": [
      {
        "language": "python"
      }
    ],
    "debuggers": [
      {
        "type": "protopy",
        "label": "protoPython (protopy)",
        "languages": [
          "python"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Absolute path to the Python script to run on protopy.",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Command-line arguments for the script (sys.argv[1:]).",
                "default": []
              },
              "cwd": {
                "type": "string",
                "description": "Working directory of the script. Default: the adapter's (the workspace folder).",
                "default": "${workspaceFolder}"
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Environment variables set for the script.",
                "default": {}
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop at the first line of the script.",
                "default": false
              },
              "pathMappings": {
                "type": "array",
                "description": "Folders the client and protopy name differently (protopy on another machine, in WSL or in a container): each maps localRoot (this machine) to remoteRoot (where protopy runs). Longest prefix wins. Files under no mapping are shown read-only from protopy's side.",
                "items": {
                  "type": "object",
                  "required": [
                    "localRoot",
                    "remoteRoot"
                  ],
                  "properties": {
                    "localRoot": {
                      "type": "string",
                      "description": "A folder on this machine, e.g. ${workspaceFolder}."
                    },
                    "remoteRoot": {
                      "type": "string",
                      "description": "The same folder where protopy runs, e.g. /home/me/project."
                    }
                  }
                },
                "default": [
                  {
                    "localRoot": "${workspaceFolder}",
                    "remoteRoot": ""
                  }
                ]
              },
              "remote": {
                "type": "object",
                "description": "Run protopy --dap through a command (ssh, wsl, docker exec, ...): the adapter speaks DAP over that command's stdin/stdout. Requires pathMappings.",
                "required": [
                  "command"
                ],
                "properties": {
                  "command": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "The argv prefix, e.g. [\"ssh\", \"-T\", \"-o\", \"BatchMode=yes\", \"me@host\"] or [\"wsl\", \"-d\", \"Ubuntu-24.04\", \"--\"]."
                  },
                  "path": {
                    "type": "string",
                    "description": "protopy on the remote side (default: protopy, found on its PATH).",
                    "default": "protopy"
                  }
                }
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "protopy",
            "request": "launch",
            "name": "protopy: current file",
            "program": "${file}",
            "cwd": "${fileDirname}",
            "stopOnEntry": false
          }
        ],
        "configurationSnippets": [
          {
            "label": "protoPython: Launch current file",
            "description": "Debug the active Python file on protopy.",
            "body": {
              "type": "protopy",
              "request": "launch",
              "name": "protopy: current file",
              "program": "^\"\\${file}\"",
              "cwd": "^\"\\${fileDirname}\"",
              "stopOnEntry": false
            }
          },
          {
            "label": "protoPython: Launch over SSH",
            "description": "Run protopy --dap on another machine through ssh.",
            "body": {
              "type": "protopy",
              "request": "launch",
              "name": "protopy: over SSH",
              "program": "^\"/home/${1:user}/${2:project}/\\${fileBasename}\"",
              "cwd": "^\"/home/${1:user}/${2:project}\"",
              "remote": {
                "command": [
                  "ssh",
                  "-T",
                  "-o",
                  "BatchMode=yes",
                  "${1:user}@${3:host}"
                ],
                "path": "protopy"
              },
              "pathMappings": [
                {
                  "localRoot": "^\"\\${workspaceFolder}\"",
                  "remoteRoot": "/home/${1:user}/${2:project}"
                }
              ]
            }
          },
          {
            "label": "protoPython: Launch in WSL",
            "description": "Run protopy --dap inside a WSL distribution.",
            "body": {
              "type": "protopy",
              "request": "launch",
              "name": "protopy: in WSL",
              "program": "^\"/home/${1:user}/${2:project}/\\${fileBasename}\"",
              "cwd": "^\"/home/${1:user}/${2:project}\"",
              "remote": {
                "command": [
                  "wsl",
                  "-d",
                  "${3:Ubuntu-24.04}",
                  "--"
                ],
                "path": "/home/${1:user}/.local/bin/protopy"
              },
              "pathMappings": [
                {
                  "localRoot": "^\"\\${workspaceFolder}\"",
                  "remoteRoot": "/home/${1:user}/${2:project}"
                }
              ]
            }
          }
        ]
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gamarino/protoPython"
  },
  "license": "MIT",
  "scripts": {
    "test": "node ./test/runTest.js"
  },
  "devDependencies": {
    "@vscode/test-electron": "2.5.2",
    "mocha": "10.8.2"
  }
}
